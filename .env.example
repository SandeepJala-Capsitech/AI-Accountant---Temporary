# Copy this file to .env (git-ignored) and paste your Groq key after GROQ_API_KEY=
# (create one at https://console.groq.com/keys). Uploaded documents are sent to Groq.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Whose books these are (tells sales invoices from purchase invoices), e.g. Northbridge Consulting Ltd
LEDGERSYNC_BUSINESS_NAME=
