# Copy this file to .env (git-ignored) and paste one key. With an OpenRouter key
# (https://openrouter.ai/keys) uploaded documents are sent to OpenRouter; without one, to Groq
# (https://console.groq.com/keys). Both read them with the same model.
# A line starting with # shows a setting's default: remove the # to change it.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MAX_OUTPUT_TOKENS=32768
# OpenRouter asks this full-precision host first, then any host at these precisions; never a 4-bit one,
# which left a line out of an expense claim every time. Blank OPENROUTER_PROVIDERS lets OpenRouter choose.
# OPENROUTER_PROVIDERS=deepinfra/bf16
# OPENROUTER_QUANTIZATIONS=bf16,fp16,fp32,fp8
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT=60.0
# GROQ_MAX_OUTPUT_TOKENS=8192
# GROQ_REASONING_EFFORT=high
# GROQ_MAX_IMAGES=3

# Everything is kept in MongoDB, and the API will not start without its address,
# e.g. mongodb://localhost:27017 (or your Atlas connection string).
MONGODB_URI=
# MONGODB_DB_NAME=ledgersync
# The most connections the API keeps to MongoDB (Atlas M0 allows 500 in all, counted on each node).
# LEDGERSYNC_MONGO_MAX_POOL=10
# The tests run against a separate MongoDB, in throwaway databases, and need this address:
# LEDGERSYNC_TEST_MONGODB_URI=mongodb://localhost:27017

# Whose books these are (tells sales invoices from purchase invoices), e.g. Northbridge Consulting Ltd
LEDGERSYNC_BUSINESS_NAME=
# LEDGERSYNC_HOST=127.0.0.1
# LEDGERSYNC_PORT=8085
# LEDGERSYNC_RELOAD=0
# LEDGERSYNC_WARMUP=1
# LEDGERSYNC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# LEDGERSYNC_MAX_UPLOAD_MB=20
# LEDGERSYNC_MAX_PDF_PAGES=30
# LEDGERSYNC_MAX_PARALLEL_JOBS=5
# LEDGERSYNC_LOG_LEVEL=INFO
