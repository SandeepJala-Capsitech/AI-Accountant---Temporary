data: {"sorted": [], "questions": [{"client_id": 2, "year_start": "2026-04-01", "row_ids": [22], "kind": "other", "text": "What was the £1,163.10 Stripe payment received on 15 Oct 2026 for? Please send the invoice (or tell me the net amount and the VAT rate you charged) so I can book the output VAT.", "why": "No invoice is on file matching this payout, so the VAT on the sale can't be determined. The invoice or a stated net amount and rate will let me book the sale and its VAT correctly.", "source": "agent", "id": "33292bcbf65a47589623fba7def3ff75", "status": "open", "answer": null, "created_at": "2026-11-04T12:01:39+00:00", "resolved_at": null}, {"client_id": 2, "year_start": "2026-04-01", "row_ids": [26], "kind": "other", "text": "Can you send the payroll report for October 2026 (gross pay, employee and employer NI, PAYE) for the £612.40 paid to HMRC on 25 Oct 2026?", "why": "The bank payment is booked against the PAYE liability, but without the payroll report the wages and National Insurance for the month aren't booked in full. The report will settle the remaining entries.", "source": "agent", "id": "542c2abf6fbf4094a0285a247e2f33fd", "status": "open", "answer": null, "created_at": "2026-11-04T12:01:39+00:00", "resolved_at": null}, {"client_id": 2, "year_start": "2026-04-01", "row_ids": [16], "kind": "receipt_or_invoice", "text": "Can you upload the receipt or invoice?", "why": "£86.40 to Screwfix Direct on 3 Oct 2026. £50 or more, so I need it. Held in Suspense as Documentation required until then.", "source": "rules", "id": "33374d85f994402b8f6a7f3bd975de44", "status": "open", "answer": null, "created_at": "2026-11-04T12:02:20+00:00", "resolved_at": null}], "trial_balance": {"lines": [{"code": "0030", "name": "Office Equipment", "type": "asset", "debit": "1208.33", "credit": "0.00"}, {"code": "1100", "name": "Debtors", "type": "asset", "debit": "600.00", "credit": "0.00"}, {"code": "1200", "name": "Bank Current Account", "type": "asset", "debit": "0.00", "credit